{
  "name": "@the-web-app/ui",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && postcss src/tailwind.css -o dist/tailwind.css --config postcss.config.mjs"
  },
  "exports": {
    "./styles": "./dist/tailwind.css",
    ".": "./src/index.ts",
    "./config": "./tailwind.config.ts"
  },
  "dependencies": {
    "@the-web-app/types": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^4.1.11"
  }
}
